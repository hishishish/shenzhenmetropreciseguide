/* pages/index/index.wxss */
page {
  background-color: #f5f5f4; /* bg-stone-50 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #1c1917; /* text-stone-900 */
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: 160rpx; /* Space for bottom tab bar */
}

/* Header / Nav */
.wechat-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f4;
  font-weight: bold;
  font-size: 32rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.content-scroll {
  flex: 1;
  padding: 40rpx;
}

.header-section {
  margin-bottom: 60rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.title-line {
  width: 6rpx;
  height: 48rpx;
  background-color: #10b981; /* emerald-500 */
  border-radius: 999rpx;
}

.title-text {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.subtitle-text {
  font-size: 20rpx;
  font-weight: bold;
  color: #a8a29e; /* stone-400 */
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

/* Station Picker */
.picker-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 1rpx solid rgba(0,0,0,0.05);
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.picker-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #ecfdf5; /* emerald-50 */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.picker-icon {
  width: 32rpx;
  height: 32rpx;
  color: #059669; /* emerald-600 */
}

.picker-content {
  flex: 1;
}

.picker-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #a8a29e;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
  display: block;
}

.picker-input {
  font-size: 36rpx;
  font-weight: bold;
  color: #1c1917;
}

/* Swap Button */
.swap-wrap {
  position: relative;
  height: 0;
  z-index: 10;
}

.swap-btn {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  border: 1rpx solid #f5f5f4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swap-icon {
  width: 32rpx;
  height: 32rpx;
  color: #a8a29e;
}

/* Plan Button */
.plan-btn {
  width: 100% !important;
  background-color: #1c1917;
  color: #fff;
  padding: 32rpx 0;
  border-radius: 32rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 20rpx 40rpx rgba(28, 25, 23, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 40rpx;
}

.plan-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* Results Section */
.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 80rpx;
  margin-bottom: 40rpx;
}

.results-title {
  font-size: 20rpx;
  font-weight: 900;
  color: #a8a29e;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.results-badge {
  font-size: 18rpx;
  font-weight: bold;
  color: #059669;
  background-color: #ecfdf5;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.route-card {
  background: #fff;
  border-radius: 48rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
}

.best-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #10b981;
  color: #fff;
  font-size: 18rpx;
  font-weight: 900;
  padding: 8rpx 24rpx;
  border-bottom-left-radius: 24rpx;
  text-transform: uppercase;
}

.route-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  color: #a8a29e;
}

.meta-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #a8a29e;
}

.route-visual {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.visual-station {
  font-size: 28rpx;
  font-weight: 900;
  color: #1c1917;
}

.visual-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid;
  margin: 0 8rpx;
}

.line-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.line-name {
  font-size: 20rpx;
  font-weight: 900;
}

.visual-arrow {
  font-size: 24rpx;
  color: #d6d3d1;
  margin: 0 4rpx;
}

.visual-transfer {
  padding: 4rpx 16rpx;
  background-color: #fffbeb; /* amber-50 */
  border: 1rpx solid #fef3c7; /* amber-100 */
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 900;
  color: #b45309; /* amber-700 */
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.transfer-icon-small {
  width: 24rpx;
  height: 24rpx;
  background: #f59e0b;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  font-weight: 900;
}

.footer {
  margin-top: 80rpx;
  margin-bottom: 60rpx;
  text-align: center;
  padding-bottom: 40rpx;
}

.footer-text {
  font-size: 20rpx;
  font-weight: 900;
  color: #d6d3d1;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

/* Tab Bar */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #f5f5f4;
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  padding-bottom: 64rpx;
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #a8a29e;
}

.tab-item.active {
  color: #059669;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-text {
  font-size: 20rpx;
  font-weight: bold;
}

/* Modal Styles */
.modal-content {
  background: #f5f5f4;
  border-radius: 48rpx 48rpx 0 0;
  padding: 0;
  max-height: 90vh;
}

.modal-header {
  padding: 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f4;
  border-radius: 48rpx 48rpx 0 0;
}

.modal-body {
  padding: 40rpx;
}

.detail-step {
  position: relative;
  padding-left: 80rpx;
  padding-bottom: 48rpx;
}

.step-line {
  position: absolute;
  left: 22rpx;
  top: 48rpx;
  bottom: 0;
  width: 8rpx;
  border-radius: 999rpx;
}

.step-node {
  position: absolute;
  left: 0;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff;
  border: 8rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.node-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.step-content {
  margin-bottom: 48rpx;
}

.step-station-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.step-station-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #1c1917;
}

.step-line-badge {
  font-size: 18rpx;
  font-weight: bold;
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.step-ride-info {
  font-size: 24rpx;
  color: #78716c;
}

.step-ride-bold {
  color: #1c1917;
  font-weight: bold;
}

.step-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #10b981; /* Changed to emerald for interactivity hint */
  text-transform: uppercase;
  letter-spacing: 4rpx;
  background: #ecfdf5;
  width: fit-content;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.stops-list {
  margin-top: 16rpx;
  padding-left: 20rpx;
  border-left: 2rpx dashed #d6d3d1;
  margin-bottom: 24rpx;
}

.stop-item-detail {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.stop-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d6d3d1;
}

.stop-name {
  font-size: 20rpx;
  color: #78716c;
  font-weight: 500;
}

/* Transfer Card */
.transfer-card {
  background: #fff;
  border-radius: 48rpx;
  padding: 40rpx;
  border: 1rpx solid #f5f5f4;
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.05);
  margin-top: 24rpx;
}

.transfer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.transfer-badge-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.transfer-time-badge {
  font-size: 18rpx;
  font-weight: bold;
  color: #a8a29e;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.transfer-title-wrap {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.transfer-icon-bg {
  background: #ecfdf5;
  padding: 16rpx;
  border-radius: 24rpx;
}

.transfer-icon {
  width: 32rpx;
  height: 32rpx;
  color: #059669;
}

.transfer-main-title {
  font-size: 24rpx;
  font-weight: 900;
  color: #1c1917;
}

.transfer-sub-title {
  font-size: 20rpx;
  color: #a8a29e;
  font-weight: 500;
}

.transfer-method-badge {
  font-size: 18rpx;
  font-weight: 900;
  color: #b45309;
  background: #fef3c7;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.transfer-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.grid-item {
  background: #f5f5f4;
  border-radius: 24rpx;
  padding: 16rpx;
  text-align: center;
}

.grid-label {
  font-size: 16rpx;
  font-weight: 900;
  color: #a8a29e;
  text-transform: uppercase;
  margin-bottom: 4rpx;
  display: block;
}

.grid-value {
  font-size: 28rpx;
  font-weight: 900;
  color: #1c1917;
}

/* Train Visualization */
.train-viz {
  margin-bottom: 40rpx;
}

.train-head-row {
  height: 32rpx;
  position: relative;
  margin-bottom: 8rpx;
}

.train-head-indicator {
  position: absolute;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  transform: translateX(-50%);
  white-space: nowrap;
}

.head-arrow {
  font-size: 20rpx;
  color: #a8a29e;
}

.head-text {
  font-size: 12rpx;
  font-weight: 900;
  color: #a8a29e;
  text-transform: uppercase;
}

.train-cars {
  display: flex;
  gap: 8rpx;
  height: 48rpx;
}

.car-box {
  flex: 1;
  border-radius: 12rpx;
  border: 1rpx solid #f5f5f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  font-weight: 900;
  color: #d6d3d1;
  background: #fff;
}

.car-box.recommended {
  background: #10b981;
  border-color: #059669;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

.transfer-notes {
  display: flex;
  gap: 16rpx;
  background: rgba(251, 191, 36, 0.05);
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.1);
}

.notes-icon {
  width: 24rpx;
  height: 24rpx;
  color: #f59e0b;
  flex-shrink: 0;
}

.notes-text {
  font-size: 20rpx;
  color: #92400e;
  line-height: 1.6;
  font-weight: 500;
}

.arrival-node {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.arrival-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #1c1917;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
}

.arrival-icon {
  width: 32rpx;
  height: 32rpx;
  color: #fff;
}

.arrival-text {
  font-size: 36rpx;
  font-weight: 900;
  color: #1c1917;
}

/* Map Modal */
.map-modal-content {
  height: 100vh;
  border-radius: 0;
}

.metro-map-wrap {
  width: 100%;
  height: 100%;
  background: #f5f5f4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.metro-map {
  width: 100%;
  height: 100%;
}

